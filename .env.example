# Ollama inference server — dedicated Vultr vc2-4c-16gb VM
# Use the VM's internal IP if the K8s cluster and VM are on the same Vultr VPC
OLLAMA_HOST=10.x.x.x
OLLAMA_MODEL=gemma4:26b

# PostgreSQL — use asyncpg driver for async FastAPI
DATABASE_URL=postgresql+asyncpg://compint:password@localhost:5432/compint

# Redis — Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# GitHub — personal access token, needs public_repo read scope
GITHUB_TOKEN=ghp_...

# Lens.org patent API token — free at https://lens.org/lens/user/subscriptions
# Without this, the patents scraper is skipped (email only, no credit card)
LENS_API_TOKEN=

# FastAPI server port
PORT=8000
