# Vultr Serverless Inference
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_API_KEY=your_vultr_inference_api_key_here
INFERENCE_MODEL=nvidia/DeepSeek-V3.2-NVFP4

# PostgreSQL — use asyncpg driver for async FastAPI
DATABASE_URL=postgresql+asyncpg://compilot:password@localhost:5432/compilot

# Redis — Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# GitHub — personal access token, needs public_repo read scope
GITHUB_TOKEN=ghp_...

# Lens.org patent API token — free at https://lens.org/lens/user/subscriptions
# Without this, the patents scraper is skipped (email only, no credit card)
LENS_API_TOKEN=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# FastAPI server port
PORT=8000
