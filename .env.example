# Vultr Serverless Inference — primary LLM endpoint (OpenAI-compatible)
VULTR_INFERENCE_API_KEY=...
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1

# Ollama fallback — Vultr VM running Ollama (OpenAI-compatible API at /v1)
# Defaults to http://localhost:11434/v1 if not set
OLLAMA_URL=http://<vultr-vm-ip>:11434/v1

# PostgreSQL — use asyncpg driver for async FastAPI
DATABASE_URL=postgresql+asyncpg://compint:password@localhost:5432/compint

# Redis — Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# GitHub — personal access token, needs public_repo read scope
GITHUB_TOKEN=ghp_...

# FastAPI server port
PORT=8000
